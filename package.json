{
  "name": "grip-regelplekken",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:azure": "NEXT_PUBLIC_GRIP_PLATFORM=azure GRIP_DIST=.next-azure next build && cp -r .next-azure/static .next-azure/standalone/.next-azure/static",
    "build:dela": "NEXT_PUBLIC_GRIP_GASTEN=uit npm run build:azure",
    "test:e2e:azure": "playwright test -c playwright.azure.config.ts",
    "test:rook": "playwright test -c playwright.rook.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "^15.5.28",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "description": "GRIP Regelplekken: voorspellen, roosteren en toetsen van regelplekken",
  "overrides": {
    "postcss": "$postcss",
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2",
    "ws": "^8.22.0",
    "undici": "^7.30.2",
    "postcss-selector-parser": "^6.1.5"
  }
}
